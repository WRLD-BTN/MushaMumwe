# Database connection string
DATABASE_URL="file:./dev.db"

# Local port for the dashboard server
PORT=4000

# Secret for signing JWT session tokens (generate a long random string)
JWT_SECRET="change_this_to_a_long_random_string"

# Super Admin credentials (bypass department login, full system access)
SUPER_ADMIN_USERNAME=Admin
SUPER_ADMIN_PASSWORD=change_this_password