generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Ward {
  id        Int       @id @default(autoincrement())
  name      String
  capacity  Int
  patients  Patient[]
  employees Employee[]
}

model Patient {
  id                  Int          @id @default(autoincrement())
  name                String
  dob                 DateTime?
  gender              String?
  nationalId          String?      @unique
  admissionDate       DateTime     @default(now())
  wardId              Int?
  ward                Ward?        @relation(fields: [wardId], references: [id])
  status              String       @default("admitted")
  attendingDoctor     String?
  updatedAt           DateTime     @updatedAt

  diagnosis           String?
  symptoms            String?
  phone               String?
  bloodGroup          String?

  finalDiagnosis      String?
  treatmentSummary    String?
  outcome             String?
  dischargeDate       DateTime?
  dischargeNotes      String?
  dischargedBy        String?
  nextReviewDate      DateTime?
  reviewDepartment    String?
  patientInstructions String?

  causeOfDeath        String?

  statusLogs          StatusLog[]
}

model StatusLog {
  id         Int      @id @default(autoincrement())
  patientId  Int
  patient    Patient  @relation(fields: [patientId], references: [id])
  oldStatus  String
  newStatus  String
  changedBy  String
  timestamp  DateTime @default(now())
}

model Employee {
  id                Int                @id @default(autoincrement())
  name              String
  department        String
  role              String?
  wardId            Int?
  ward              Ward?              @relation(fields: [wardId], references: [id])
  status            String             @default("active")
  hireDate          DateTime           @default(now())
  terminationDate   DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  statusLogs        EmployeeStatusLog[]
  disciplinaryCases DisciplinaryCase[]
  movements         EmployeeMovement[]
}

model EmployeeStatusLog {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  oldStatus  String
  newStatus  String
  changedBy  String
  timestamp  DateTime @default(now())
}

model EmployeeMovement {
  id                 Int      @id @default(autoincrement())
  employeeId         Int
  employee           Employee @relation(fields: [employeeId], references: [id])

  movementType       String

  fromDepartment     String?
  fromWardId         Int?
  toDepartment       String?
  toWardId           Int?

  plannedDate        DateTime?
  actualDate         DateTime?
  yearsOfService     Int?
  pensionNotes       String?

  resignationDate    DateTime?
  lastWorkingDay     DateTime?
  noticePeriodDays   Int?
  reason             String?
  exitInterviewDone  Boolean  @default(false)
  eligibleForRehire  Boolean?

  effectiveDate      DateTime?
  notes              String?
  approvedBy         String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model EstablishmentTarget {
  id            Int      @id @default(autoincrement())
  department    String   @unique
  minHeadcount  Int      @default(0)
  maxHeadcount  Int?
  notes         String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrderRequest {
  id                    Int                       @id @default(autoincrement())
  requestingDepartment  String
  originatorDepartment  String?
  requestingBy          String
  itemName              String
  quantity              Int
  reason                String
  status                String                    @default("pending")
  urgency               String?                   @default("normal")
  category              String?
  attachmentPath        String?
  attachmentName        String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  statusLogs            OrderRequestStatusLog[]
  procurementOrder      ProcurementOrder?
}

model OrderRequestStatusLog {
  id             Int          @id @default(autoincrement())
  orderRequestId Int
  orderRequest   OrderRequest @relation(fields: [orderRequestId], references: [id])
  oldStatus      String
  newStatus      String
  changedBy      String
  notes          String?
  timestamp      DateTime     @default(now())
}

model ProcurementOrder {
  id                   Int          @id @default(autoincrement())
  orderRequestId       Int          @unique
  orderRequest         OrderRequest @relation(fields: [orderRequestId], references: [id])
  supplierName         String
  orderDate            DateTime     @default(now())
  expectedDate         DateTime?
  expectedDeliveryDate DateTime?
  approvalNotes        String?
  status               String       @default("ordered")
  itemReceives         ItemReceive[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model InventoryItem {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  quantity     Int           @default(0)
  unit         String
  category     String?
  expiryDate   DateTime?
  lastReceived DateTime?
  itemReceives ItemReceive[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ItemReceive {
  id                 Int              @id @default(autoincrement())
  procurementOrderId Int
  procurementOrder   ProcurementOrder @relation(fields: [procurementOrderId], references: [id])
  inventoryItemId    Int
  inventoryItem      InventoryItem    @relation(fields: [inventoryItemId], references: [id])
  quantityReceived   Int
  receivedBy         String
  receivedAt         DateTime         @default(now())
  notes              String?
  createdAt          DateTime         @default(now())
}

model User {
  id           Int     @id @default(autoincrement())
  username     String  @unique
  passwordHash String
  fullName     String
  department   String
  role         String  @default("staff")
  wardId       Int?
}

model SystemSettings {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model DisciplinaryCase {
  id            Int      @id @default(autoincrement())
  caseNumber    String   @unique
  employeeId    Int
  employee      Employee @relation(fields: [employeeId], references: [id])

  offenseType   String
  description   String
  reportedBy    String
  reportedDate  DateTime
  witnesses     String?

  status        String   @default("open")

  actionTaken   String?
  actionDetails String?
  outcome       String?

  hearingDate   DateTime?
  hearingNotes  String?
  effectiveDate DateTime?
  durationDays  Int?

  closedBy      String?
  closedDate    DateTime?
  reopenedBy    String?
  reopenedDate  DateTime?
  reopenReason  String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  statusLogs    DisciplinaryStatusLog[]
  attachments   DisciplinaryAttachment[]
}

model DisciplinaryStatusLog {
  id        Int              @id @default(autoincrement())
  caseId    Int
  case      DisciplinaryCase @relation(fields: [caseId], references: [id])
  oldStatus String
  newStatus String
  changedBy String
  notes     String?
  timestamp DateTime         @default(now())
}

model DisciplinaryAttachment {
  id           Int              @id @default(autoincrement())
  caseId       Int
  case         DisciplinaryCase @relation(fields: [caseId], references: [id])
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  uploadedBy   String
  uploadedAt   DateTime         @default(now())
}

model Project {
  id              Int             @id @default(autoincrement())
  name            String
  description     String
  department      String
  projectHead     String
  status          String          @default("ongoing")
  startDate       DateTime?
  targetDate      DateTime?
  obstacleReason  String?
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  updates         ProjectUpdate[]

  @@index([department])
  @@index([status])
  @@index([updatedAt])
}

model ProjectUpdate {
  id               Int      @id @default(autoincrement())
  projectId        Int
  project          Project  @relation(fields: [projectId], references: [id])
  note             String
  statusAtUpdate   String
  obstacleReason   String?
  actionTaken      String?
  updatedBy        String
  timestamp        DateTime @default(now())

  @@index([projectId])
  @@index([timestamp])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  timestamp    DateTime @default(now())
  userId       Int?
  username     String
  fullName     String
  department   String
  role         String
  action       String
  entity       String
  entityId     String?
  summary      String
  before       String?
  after        String?
  ipAddress    String?
  userAgent    String?
  deviceTag    String?

  @@index([timestamp])
  @@index([username])
  @@index([entity])
  @@index([action])
  @@index([department])
}